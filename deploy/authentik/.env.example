# Generated into .env by setup-local.sh. Never commit .env.
PG_PASS=REPLACE_WITH_RANDOM_SECRET
AUTHENTIK_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
# Optional: set to the HTTPS URL served by Authentik for the protected demo app.
PORTAL_TEST_EXTERNAL_HOST=
# Optional pilot only: after authentication/direct-route checks pass, set the tailnet HTTPS URL for Books, e.g. https://<machine>.ts.net:8444.
PORTAL_BOOKS_EXTERNAL_HOST=
# Optional Audiobookshelf browser gateway; keep the existing native-client route until compatibility is verified.
PORTAL_AUDIOBOOKSHELF_EXTERNAL_HOST=
# Optional native OIDC; set the client secret and all three URIs to enable the scoped provider.
# Use exact HTTPS URLs; authorization callbacks are strict and logout is a Post Logout URI.
PORTAL_AUDIOBOOKSHELF_OIDC_CLIENT_SECRET=
PORTAL_AUDIOBOOKSHELF_OIDC_WEB_CALLBACK_URL=
# Optional additional exact callback for the Authentik-protected browser gateway (e.g. HTTPS host:port/base-path/auth/openid/callback).
PORTAL_AUDIOBOOKSHELF_OIDC_GATEWAY_CALLBACK_URL=
PORTAL_AUDIOBOOKSHELF_OIDC_MOBILE_CALLBACK_URL=
PORTAL_AUDIOBOOKSHELF_OIDC_LOGOUT_CALLBACK_URL=
# Optional owner-only metrics gateway; set the tailnet HTTPS URL, e.g. https://<machine>.ts.net:8447.
PORTAL_METRICS_EXTERNAL_HOST=
# Optional Owner-only Transmission Web UI proxy; disabled until an HTTPS URL is configured.
PORTAL_TRANSMISSION_EXTERNAL_HOST=
# Optional upstream RPC credentials; blank until Transmission requires the matching Basic auth.
PORTAL_TRANSMISSION_RPC_USERNAME=
PORTAL_TRANSMISSION_RPC_PASSWORD=
# Optional Family/Owner Grocy gateway; enable only with the reviewed private-network overlay and data migration.
PORTAL_GROCY_EXTERNAL_HOST=
# Private service alias used only with deploy/authentik/compose.grocy.yml.
PORTAL_GROCY_INTERNAL_HOST=http://grocy:80
# The Grocy API bypass is intentionally disabled in the blueprint; no skip regex is exposed here.
# Optional Immich native OIDC client. The blueprint exposes an email scope mapping; email matching can link existing accounts.
# The sample invitation flow does not verify email ownership. Keep this provider disabled until a trusted verification policy exists.
# Use strict exact callbacks from every Immich web origin plus app.immich:///oauth-callback for Android/iOS.
# Optional extra web origin for a chosen tailnet/LAN hostname; set both exact callbacks to preserve login and linking.
PORTAL_IMMICH_OIDC_CLIENT_SECRET=
PORTAL_IMMICH_OIDC_WEB_LOGIN_CALLBACK_URL=
PORTAL_IMMICH_OIDC_WEB_LINK_CALLBACK_URL=
PORTAL_IMMICH_OIDC_LAN_LOGIN_CALLBACK_URL=
PORTAL_IMMICH_OIDC_LAN_LINK_CALLBACK_URL=
PORTAL_IMMICH_OIDC_TAILNET_LOGIN_CALLBACK_URL=
PORTAL_IMMICH_OIDC_TAILNET_LINK_CALLBACK_URL=
# Optional secure HTTPS origin for LAN and tailnet access; both strict callbacks are added only when both are set.
PORTAL_IMMICH_OIDC_HTTPS_LOGIN_CALLBACK_URL=
PORTAL_IMMICH_OIDC_HTTPS_LINK_CALLBACK_URL=
PORTAL_IMMICH_OIDC_MOBILE_CALLBACK_URL=
# Optional private upstream for an Owner-only system-status dashboard widget.
# Use the local API URL; the external metrics URL above supplies its required Host header.
PORTAL_STATUS_UPSTREAM_URL=
# Required only with compose.grocy.yml; pin the image digest and preserve the current /config and identity values.
GROCY_IMAGE=
GROCY_CONFIG_PATH=
GROCY_PUID=
GROCY_PGID=
GROCY_TZ=
